{
  "name": "projectx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "X — AI transportation assistant for Morocco (prototype)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "framer-motion": "^11.18.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.73.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "postcss": "^8.5.33",
    "tailwindcss": "3.4",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vite": "5.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^2.1.9"
  }
}
