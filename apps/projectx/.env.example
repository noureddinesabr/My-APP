# X server configuration. Copy to .env and fill in. Never commit .env.
# Without ANTHROPIC_API_KEY the app runs in clearly labelled DEMO mode.

# Which AI provider the server uses: "anthropic" (real AI) or "demo".
AI_PROVIDER=anthropic
# Secret key from https://console.anthropic.com — stays on the server only.
ANTHROPIC_API_KEY=
# Model used for conversation and photo analysis.
AI_MODEL=claude-opus-5-5
# low | medium | high — lower answers faster.
AI_EFFORT=low
# Port of the X API server (the web app proxies /api to it in development).
PORT=8787
