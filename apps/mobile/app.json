{
  "expo": {
    "name": "Xapp",
    "slug": "xapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "xapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "ma.xapp.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B21B6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ma.xapp.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E0B45",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": {
            "ios": [
              "ar",
              "fr",
              "en"
            ],
            "android": [
              "ar",
              "fr",
              "en"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Xapp needs access to your photos so you can share photos and videos of your load, your documents and in the chat.",
          "cameraPermission": "Xapp needs the camera so you can take photos and videos of your load, your documents and in the chat.",
          "microphonePermission": "Xapp needs the microphone to record sound with your videos."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Xapp needs the microphone so you can send voice notes to drivers and clients."
        }
      ],
      "expo-video",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Xapp uses your location to set the pickup point and show where the driver is."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
